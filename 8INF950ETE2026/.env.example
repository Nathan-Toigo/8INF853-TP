# Copier ce fichier en ".env" (ignoré par git) et renseigner les valeurs nécessaires
# selon le fournisseur LLM utilisé par scripts/generate_with_llm.py

# --- Azure AI Foundry (endpoint unifié compatible OpenAI, Responses API) ---
AZURE_OPENAI_ENDPOINT=https://<votre-projet>.services.ai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# --- LLM local (ex. Ollama, API compatible OpenAI) ---
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.1
LOCAL_LLM_API_KEY=local
